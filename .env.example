# Canonical public origin used by metadata and RSS generation.
NEXT_PUBLIC_SITE_URL=https://dirtycoin.sol

# Production Solana RPC endpoints in failover order. These values are embedded
# in the static bundle: use browser-safe, origin-restricted credentials only.
# NEXT_PUBLIC_SOLANA_RPC_URLS=https://your-browser-safe-mainnet-rpc.example

# Optional when the provider uses a distinct WebSocket endpoint.
# NEXT_PUBLIC_SOLANA_RPC_SUBSCRIPTIONS_URL=wss://your-browser-safe-mainnet-rpc.example

# Required production Leaderboard snapshot or mutable pointer. This public URL
# cannot contain a secret; the local bundled snapshot is development-only.
# NEXT_PUBLIC_LEADERBOARD_SNAPSHOT_URL=https://your-public-snapshot.example/leaderboard.json

# Required production market snapshot or mutable pointer. It is generated
# outside the static site; no provider key belongs in this public URL.
# NEXT_PUBLIC_MARKET_SNAPSHOT_URL=https://your-public-snapshot.example/market.json
